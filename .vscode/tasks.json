{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build game",
            "type": "process",
            "command": "${workspaceFolder}\\raylib\\w64devkit\\bin\\gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c99",
                "-I${workspaceFolder}\\raylib\\raylib\\src",
                "${workspaceFolder}\\test.c",
                "-o",
                "${workspaceFolder}\\test.exe",
                "-L${workspaceFolder}\\raylib\\raylib\\src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
